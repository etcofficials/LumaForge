// Generated into the build tree by CMake (configure_file). Edit LumaForge.rc.in.
#include <windows.h>

IDI_ICON1 ICON "@LF_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "LumaForge"
      VALUE "FileDescription", "@LF_FILE_DESCRIPTION@"
      VALUE "FileVersion", "@PROJECT_VERSION@.0"
      VALUE "InternalName", "@LF_INTERNAL_NAME@"
      VALUE "LegalCopyright", "LumaForge contributors"
      VALUE "OriginalFilename", "@LF_ORIGINAL_FILENAME@"
      VALUE "ProductName", "LumaForge"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
